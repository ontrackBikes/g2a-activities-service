{
  "name": "activities-service",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "dev:media": "NODE_ENV=development nodemon workers/media-processing.js",
    "dev:media-cleanup": "NODE_ENV=development nodemon workers/media-cleanup.js",
    "start:staging": "NODE_ENV=staging pm2 start server.js --name activities-service-staging --update-env",
    "start:prod": "NODE_ENV=production pm2 start server.js --name activities-service-prod --update-env",
    "restart:staging": "NODE_ENV=staging pm2 restart activities-service-staging --update-env",
    "restart:prod": "NODE_ENV=production pm2 restart activities-service-prod --update-env",
    "stop:staging": "pm2 stop activities-service-staging",
    "stop:prod": "pm2 stop activities-service-prod",
    "generate_token": "node scripts/generateToken.js",
    "worker:media": "node workers/media-processing.js",
    "worker:media-cleanup": "node workers/media-cleanup.js",
    "pm2:media": "pm2 start workers/media-processing.js --name activities-media-worker",
    "pm2:media-cleanup": "pm2 start workers/media-cleanup.js --name activities-media-cleanup-worker",
    "pm2:restart-media": "pm2 restart activities-media-worker",
    "pm2:restart-media-cleanup": "pm2 restart activities-media-cleanup-worker"
  },
  "dependencies": {
    "bullmq": "^5.79.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^170.0.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.35",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "multer": "^2.2.0",
    "mysql2": "^3.22.5",
    "node-cron": "^3.0.3",
    "razorpay": "^2.9.6",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
