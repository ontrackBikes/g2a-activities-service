  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "dev:workers": "cross-env NODE_ENV=development concurrently -n MEDIA,CLEANUP,SCHEDULE,SETTLEMENT \"nodemon workers/media-processing.js\" \"nodemon workers/media-cleanup.js\" \"nodemon workers/vendor-schedule.js\" \"nodemon workers/payment-settlement.js\"",
    "dev:media": "cross-env NODE_ENV=development nodemon workers/media-processing.js",
    "dev:media-cleanup": "cross-env NODE_ENV=development nodemon workers/media-cleanup.js",
    "dev:vendor-schedule": "cross-env NODE_ENV=development nodemon workers/vendor-schedule.js",
    "dev:payment-settlement": "cross-env NODE_ENV=development nodemon workers/payment-settlement.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:staging": "pm2 start ecosystem.config.js --env staging",
    "pm2:start:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "bullmq": "^5.79.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^170.0.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.35",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "multer": "^2.2.0",
    "mysql2": "^3.22.5",
    "node-cron": "^3.0.3",
    "postmark": "^5.0.0",
    "razorpay": "^2.9.6",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0"
  }
}
