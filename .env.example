# .env.example
PORT=3000
NODE_ENV=development

# Public base URL of this API/app - used to build links back into the app
# (e.g. the "retry payment" link in payment-failed/payment-pending emails).
APP_URL=

# IANA timezone used for all date/time math (schedule generation, cron
# firing times, lead-time checks, "today" cutoffs, etc). Defaults to
# "Asia/Kolkata" everywhere it's read if unset.
APP_TIMEZONE=Asia/Kolkata

# MySQL (config/sequelize.js). All required - no defaults except DB_PORT.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis. Note: BullMQ queues/workers connect via REDIS_HOST/PORT/PASSWORD
# (config/redis.js), while the /health endpoint's Redis check connects
# separately via REDIS_URL (utils/healthCheck.js) - set both.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT (services/jwt.service.js). JWT_SECRET is required - the process
# throws on boot if unset. NOTE: middlewares/auth.middleware.js#validateUser
# currently short-circuits before actually checking the token either way,
# so auth is effectively disabled repo-wide regardless of this value.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Bearer token required (Authorization: Bearer <token>) on every
# .../:id/permanent hard-delete route (products, locations, ...) -
# separate from the JWT auth middleware.
PERMANENT_DELETE_TOKEN=

# One-time admin bootstrap (scripts/createAdminUser.js). Only read by that
# script, not by the running server. ADMIN_PASSWORD must be 8+ characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Google Sheets
SPREAD_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Falls back to SPREAD_SHEET_ID if unset.
SPREAD_SHEET_ID_BIKE_RENTALS=

# Google Maps (Places Text Search)
GOOGLE_MAPS_API_KEY=

# Secret used to sign/verify coordinates returned by the Places search
# endpoint, so custom transfer pickup/drop locations can be verified
# server-side instead of trusting client-submitted lat/lng directly.
# Falls back to GOOGLE_MAPS_API_KEY if unset.
PLACE_COORDINATE_SIGNATURE_SECRET=

# Bike rental date-range bookings can't extend further than this many
# days out. Defaults to 90 if unset.
BIKE_RENTAL_MAX_DAYS=90

# Razorpay
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Postmark
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=

# Internal team address(es) BCC'd/CC'd on payment-failed and
# payment-pending emails (comma-separated for multiple addresses).
EMAIL_BCC_TEAM=
EMAIL_CC_TEAM=

# Media (models/mediaLibrary.model.js, services/image.service.js) and
# documents (models/document.model.js, services/document.service.js)
# uploads, served from /uploads. MEDIA_FILE_BASE_URL is the public base
# URL prefixed onto every stored file's url/file_url (media AND documents
# both use this one var - there's no separate DOCUMENT_FILE_BASE_URL).
# Leave unset only for local dev (falls back to the relative path
# "/uploads/..."); set it to an absolute URL (CDN or this API's own public
# domain) anywhere the URL needs to resolve outside the browser that
# fetched it - e.g. links embedded in emails.
MEDIA_FILE_BASE_URL=
MEDIA_MAX_FILE_SIZE_MB=200
MEDIA_WORKER_CONCURRENCY=2

# Documents are re-encoded to JPEG (services/document.service.js) before
# storage - not resized/compressed like media's multi-size variants.
DOCUMENT_MAX_FILE_SIZE_MB=20
DOCUMENT_IMAGE_MAX_DIMENSION=1600
DOCUMENT_IMAGE_QUALITY=70
