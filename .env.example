# .env.example
PORT=3000

# Google Sheets
SPREAD_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Maps (Places Text Search)
GOOGLE_MAPS_API_KEY=

# Secret used to sign/verify coordinates returned by the Places search
# endpoint, so custom transfer pickup/drop locations can be verified
# server-side instead of trusting client-submitted lat/lng directly.
# Falls back to GOOGLE_MAPS_API_KEY if unset.
PLACE_COORDINATE_SIGNATURE_SECRET=

# Razorpay
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Postmark
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=

# Internal team address(es) BCC'd/CC'd on payment-failed and
# payment-pending emails (comma-separated for multiple addresses).
EMAIL_BCC_TEAM=
EMAIL_CC_TEAM=
